porc_growth <- function(filtered_df, fila_informalidad, fila_poblacion_ocupada, data){
for (i in seq_along(filtered_df)) {
nombre_actual <- names(filtered_df)[i]
df <- filtered_df[[i]]     # se queda tal cual, sin convertir nada permanentemente
# Convertir SOLO al vuelo, para el calculo, sin tocar df
informalidad      <- as.numeric(as.character(unlist(df[fila_informalidad, -1])))
poblacion_ocupada  <- as.numeric(as.character(unlist(df[fila_poblacion_ocupada, -1])))
fraccion <- informalidad / poblacion_ocupada *100
print(fraccion)
nombre_col1 <- names(df)[1]
# Convertir el resultado de vuelta a texto, para que coincida con el resto del df
nuevos_valores <- setNames(as.list(as.character(fraccion)), names(df)[-1])
new_row <- tibble(
!!nombre_col1 := "informalidad %",
!!!nuevos_valores
)
filtered_df[[i]] <- bind_rows(df, new_row)
print(filtered_df[[i]])
}
for (i in seq_along(filtered_df)) {
nombre_actual <- names(filtered_df)[i]
df <- filtered_df[[i]]
comparison_results <- growth_results(df, last_col_idx, one_year_ago_idx)
col_name_last <- paste(diccionary_months[month], year)       # e.g., "Jul 2026"
col_name_prev <- paste(diccionary_months[month], year-1)          # e.g., "Jul 2025"
labels_comparison <- list(
# Usamos dobles corchetes [] para evaluar el contenido de tus variables de texto
"col_prev" = col_name_prev,
"col_last" = col_name_last,
"Difference" = "Difference (Raw)",
"% increment" = "Increment % (Raw)",
"Difference rounded" = "Difference (Rounded)",
"% increment rounded" = "Increment % (Rounded)"
)
save_gt_table(
df = comparison_results,
output_path = paste0(i_path, "/results/", diccionary_months[month],"-", year,"/",data,"/tasa_crecimiento_entre_anos_",nombre_actual,".png"),
labels_mapping = labels_comparison,
title = "Tasa de Crecimiento Entre Años"
)
}
}
porc_growth(filtered_df, fila_informalidad, fila_poblacion_ocupada, "grandesDominios")
