show.legend = FALSE
) +
scale_color_manual(
values = colores,
name   = NULL,
breaks = indicador,
labels = labels_needed
) +
scale_y_continuous(
name    = NULL,
limits  = c(left_min, left_max),
sec.axis = sec_axis(
~ (. - left_min) / escala + right_min,
name   = NULL,
breaks = seq(right_min, right_max, length.out = 5)  # exactos, sin redondear, entre right_min y right_max
)
) +
scale_x_date(
breaks = breaks_x,
labels = formatear_fecha
) +
theme_minimal(base_size = 14) +
theme(
axis.title       = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.text.x      = element_text(angle = 90, hjust = 1, vjust = 0.5),
axis.text        = element_text(color = "black", size = 13),
legend.position  = "bottom",
legend.text      = element_text(size = 10)
)
ggsave(
filename = paste0(i_path, "/results/", diccionary_months[month],"-", year,"/",var,"/graph_over_years_", var,add_name, ".png"),
plot     = final_graph,
width    = 10,
height   = 6,
dpi      = 300
)
print(final_graph)
}
