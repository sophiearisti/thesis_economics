percentages <- function(filtered_df, data){
for (i in seq_along(filtered_df)) {
nombre_actual <- names(filtered_df)[i]
df <- filtered_df[[i]]
# AJUSTA estos numeros de fila segun tu estructura real:
# 3 = Fuerza de trabajo (WF), 4 = Formal (TF), 5 = Informal (TI)
WF_prev <- as.numeric(as.character(df[3, one_year_ago_idx]))
TF_prev <- as.numeric(as.character(df[4, one_year_ago_idx]))
TI_prev <- as.numeric(as.character(df[5, one_year_ago_idx]))
WF_curr <- as.numeric(as.character(df[3, last_col_idx]))
TF_curr <- as.numeric(as.character(df[4, last_col_idx]))
TI_curr <- as.numeric(as.character(df[5, last_col_idx]))
# Proporciones en % - mismas unidades en prev y curr
TF_prop_prev <- TF_prev / WF_prev * 100
TF_prop_curr <- TF_curr / WF_curr * 100
TI_prop_prev <- TI_prev / WF_prev * 100
TI_prop_curr <- TI_curr / WF_curr * 100
TF_diff <- TF_prop_curr - TF_prop_prev
TI_diff <- TI_prop_curr - TI_prop_prev
# Nombres de las columnas prev/curr para las etiquetas
col_name_prev <- paste0(diccionary_months[month], " ", year - 1)
col_name_last <- paste0(diccionary_months[month], " ", year)
# ============================================================
# CREAR EL DATAFRAME NUEVO
# ============================================================
comparison_results <- tibble(
concept  = c("Informal", "Formal"),
col_prev = c(TI_prop_prev, TF_prop_prev),
col_last = c(TI_prop_curr, TF_prop_curr),
Difference          = c(TI_diff, TF_diff),
`% increment`       = c((TI_diff / TI_prop_prev) * 100, (TF_diff / TF_prop_prev) * 100),
`Difference rounded` = round(c(TI_diff, TF_diff), 1),
`% increment rounded` = round(c((TI_diff / TI_prop_prev) * 100, (TF_diff / TF_prop_prev) * 100), 1)
)
labels_comparison <- list(
"concept"  = "Concepto",
"col_prev" = col_name_prev,
"col_last" = col_name_last,
"Difference"           = "Difference (Raw)",
"% increment"          = "Increment % (Raw)",
"Difference rounded"   = "Difference (Rounded)",
"% increment rounded"  = "Increment % (Rounded)"
)
save_gt_table(
df = comparison_results,
output_path = paste0(i_path, "/results/", diccionary_months[month], "-", year, "/",data,"/prop_entre_anos_", nombre_actual, ".png"),
labels_mapping = labels_comparison,
title = "Tasa de Crecimiento Entre Años"
)
}
}
percentages(filtered_df, "grandesDominios")
