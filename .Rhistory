cantidad_jb = mean(cantidad_jb, na.rm = TRUE),
cantidad_d1 = mean(cantidad_d1, na.rm = TRUE),
cantidad_ara = mean(cantidad_ara, na.rm = TRUE)
) %>%
ungroup()
