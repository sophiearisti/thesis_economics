filter(!codigo_upz %in% c(63, 117))
#ELIMINAR ANO 2023
panel_merged <- panel_merged %>%
filter(year < 2023)
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
# 1. Ver cuáles tienen el total de periodos (T = 23)
upzs_completas <- panel_merged %>%
group_by(codigo_upz) %>%
summarise(n_periodos = n()) %>%
filter(n_periodos == 23)
# 2. Ver la lista de las UPZs que están en todos los años/trimestres
print(upzs_completas$codigo_upz)
# 1. Ver cuáles tienen el total de periodos (T = 23)
upzs_completas <- panel_merged %>%
group_by(codigo_upz) %>%
summarise(n_periodos = n()) %>%
filter(n_periodos == 19)
upzs_completas <- panel_merged %>%
group_by(codigo_upz) %>%
summarise(n_periodos = n()) %>%
filter(n_periodos == 20)
# 3. Ver cuáles son las que tienen huecos (las problemáticas)
upzs_incompletas <- panel_merged %>%
group_by(codigo_upz) %>%
summarise(n_periodos = n()) %>%
filter(n_periodos < 23)
print(upzs_incompletas)
#guardar datos en un csv
write_csv(panel_merged, file.path(dir_BDD_panel, "panel_final_con_llamadas.csv"))
# HACER ESTO OR ANO EN VEZ DE QUARTER, PARA VER LA EVOLUCION ANUAL DE LAS LLAMADAS DE EMERGENCIA POR TIPO DE INCIDENTE
df_agrupado <- df_filtrado %>%
group_by(COD_UPZ_NUM, ANIO) %>%
summarise(
total_atraco = sum(dummy_atraco, na.rm = TRUE),
total_hurto = sum(dummy_hurto, na.rm = TRUE),
total_violacion_domicilio = sum(dummy_violacion_domicilio, na.rm = TRUE),
total_alteracion_orden = sum(dummy_alteracion_orden, na.rm = TRUE),
total_violacion_maltrato = sum(dummy_violacion_maltrato, na.rm = TRUE),
total_homicidio = sum(dummy_homicidio, na.rm = TRUE),
total_pandillas_drogas = sum(dummy_pandillas_drogas, na.rm = TRUE),
total_armas = sum(dummy_armas, na.rm = TRUE),
total_rapto_secuestro = sum(dummy_rapto_secuestro, na.rm = TRUE),
total_alcohol_menores = sum(dummy_alcohol_menores, na.rm = TRUE),
total_sospechoso = sum(dummy_sospechoso, na.rm = TRUE),
total_auxilio = sum(dummy_auxilio, na.rm = TRUE),
total_tendida = sum(dummy_tendida, na.rm = TRUE)
) %>%
ungroup()
View(df_agrupado)
doc_panel    <- file.path(dir_BDD_panel, "panel_final_all_upz_anual.csv")
panel <- read_csv(doc_panel)
View(panel)
# merge entre panel (codigo_upz, year, quarter) y df_agrupado (ANIO, quarter, COD_UPZ_NUM) usando left_join de dplyr
panel_merged <- panel %>%
left_join(df_agrupado, by = c("codigo_upz" = "COD_UPZ_NUM", "year" = "ANIO"))
#todos los de total_ (en minuscula), dividirlo sobre TOTAL_POBLACION de su fila para obtener la tasa por cada tipo de incidente y multiplicar por 10,000 para obtener la tasa por cada 10,000 habitantes
panel_merged <- panel_merged %>%
mutate(
across(
.cols = starts_with("total_"),
.fns = ~ (.x / TOTAL_POBLACION) * 10000,
.names = "tasa_{.col}"
)
)
#imprimir codigo_upz que se repiten en grupo con codigo_upz year y quarter, para ver si hay duplicados
duplicados <- panel_merged %>%
group_by(codigo_upz, year, quarter) %>%
filter(n() > 1)
duplicados <- panel_merged %>%
group_by(codigo_upz, year) %>%
filter(n() > 1)
#quitar las fila duplicadas
panel_merged <- panel_merged %>%
distinct(codigo_upz, year, quarter, .keep_all = TRUE)
#quitar las fila duplicadas
panel_merged <- panel_merged %>%
distinct(codigo_upz, year, .keep_all = TRUE)
#ELIMINAR CODIGO UPZ 67 Y 117
panel_merged <- panel_merged %>%
filter(!codigo_upz %in% c(63, 117))
#ELIMINAR ANO 2023
panel_merged <- panel_merged %>%
filter(year < 2023)
#listar observaciones con TOTAL_POBLACION igual a 0, para ver si hay casos donde la tasa no se puede calcular
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
write_csv(panel_merged, file.path(dir_BDD_panel, "panel_final_con_llamadas_anual.csv"))
# Cargar librerías
library(haven)   # leer archivos .dta
library(dplyr)   # manipulación de datos
library(ggplot2) # gráficos
library(sf)        # Para manejar datos geoespaciales
library(tidyverse)  # Para manipulación de datos y gráficos
# --- Cargar datos ---
# Cambiar al directorio deseado
setwd("~/Desktop/1 economia/thesis_economics")
# Leer layer correspondiente al año
gdf <- st_read("data/maps_data/gpkg_all_years/joined_all_upz_years.gpkg",
layer = "joined_2020", quiet = TRUE)
# 1. Definir la lista de UPZ tratadas
upz_tratadas <- c(12, 19, 20, 22, 24, 25, 27, 29, 39, 91, 93, 94, 97, 100, 101, 102, 116)
# Crear columna FACTOR con etiquetas claras usando %in%
gdf <- gdf %>%
mutate(always_treated = ifelse(codigo_upz %in% upz_tratadas, "Yes", "No"),
always_treated = factor(always_treated, levels = c("Yes", "No")))
# 2. Graficar con escala manual
ggplot(gdf) +
geom_sf(aes(fill = always_treated), color = "white", size = 0.1) +
scale_fill_manual(
values = c("Yes" = "#28536B", "No" = "#C5DCE7"), # Azul oscuro para presencia, claro para ausencia
name = "Always treated?",
labels = c("Yes" = "Yes", "No" = "No")
) +
labs(title = "Always treated UPZs") + # Simplificado y corregido para el título
theme_void() +
theme(
legend.position = "bottom",
plot.title = element_text(hjust = 0.5, face = "bold"),
legend.title = element_text(size = 10),
legend.text = element_text(size = 9)
)
