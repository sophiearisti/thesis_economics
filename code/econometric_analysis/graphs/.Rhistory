# 1. Tomar la ultima fila de cada dataframe (informalidad %) y renombrar su primera columna
ultimas_filas <- map2_dfr(filtered_df, etiquetas_id, function(df, etiqueta) {
fila <- tail(df, 1)
fila[[nombre_col1]] <- etiqueta
fila
})
# 2. Tomar las 2 primeras filas (son iguales en todos, se usan solo las del primer df)
primeras_dos <- filtered_df[[1]] %>% slice(1:2)
