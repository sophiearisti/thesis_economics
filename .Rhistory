group_by(codigo_upz, year, quarter) %>%
filter(n() > 1)
View(duplicados)
View(duplicados)
panel_merged <- panel_merged %>%
distinct(codigo_upz, year, quarter, .keep_all = TRUE)
duplicados <- panel_merged %>%
group_by(codigo_upz, year, quarter) %>%
filter(n() > 1)
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
View(poblacion_cero)
panel_merged <- panel_merged %>%
filter(!codigo_upz %in% c(67, 117))
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
View(poblacion_cero)
#anadir las rutas y los archivos
#----------------------------------------------------------------------------
# Versión 1: Limpieza y merge de llamadas de emergencia con el panel procesado
#----------------------------------------------------------------------------
# 1. Cargar librerías necesarias
library(tidyverse)
library(readr)
library(dplyr)
# 2. Definición de Directorios (Equivalente a 'global' en Stata)
# Nota: En R usamos '/' y no necesitamos '$' para llamar a las variables
global_dir <- "/Users/sophiaaristizabal/Desktop/1 economia/thesis_economics"
dir_dofile      <- file.path(global_dir, "code")
dir_BDD_panel   <- file.path(global_dir, "data/panel")
dir_BDD_crimen  <- file.path(global_dir, "data/crime")
# Documentos específicos
doc_panel    <- file.path(dir_BDD_panel, "panel_final_all_upz_trimestral.csv")
doc_llamadas <- file.path(dir_BDD_crimen, "llamadas123.csv")
# 3. Importar Datos (Equivalente a 'import delimited')
# read_csv es más rápido y detecta tipos de datos automáticamente
llamadas <- read_csv(doc_llamadas)
# 4. Exploración Inicial (Equivalente a 'des')
glimpse(llamadas)
summary(llamadas)
# 5. Ver niveles de la variable (Equivalente a 'levelsof')
# Esto te servirá para ver todas las categorías de delitos antes de filtrar
niveles_detalle <- llamadas %>%
pull(TIPO_DETALLE) %>%
unique() %>%
sort()
print(niveles_detalle)
# 1. Definir el vector de categorías de interés
categorias_interes <- c(
"ALTERACIÓN DEL ORDEN PÚBLICO", "ATRACO / HURTO EN PROCESO", "DISPAROS",
"INTENTO O VIOLACIÓN DE DOMICILIO", "INTENTO/VIOLACIÓN DE DOMICILIO", "MALTRATO",
"MALTRATO A MUJER", "MANIFESTACIÓN / MOTÍN", "MANIFESTACIÓN O MOTÍN", "MUERTO",
"NARCÓTICOS", "PANDILLAS", "PANDILLAS JUVENILES", "PERSONA O VEHÍCULO SOSPECHOSO",
"PERSONA PIDIENDO AUXILIO", "PERSONA TENDIDA EN LA VÍA", "PORTE DE ARMAS",
"PORTE ILEGAL DE ARMAS", "RAPTO", "RAPTO / SECUESTRO", "RIÑA", "SECUESTRO",
"VEHÍCULO HURTADO", "VENTA O CONSUMO ALCOHOL U OTRO EN MENOR", "VIOLENCIA SEXUAL"
)
# 2. Filtrar el dataframe
# Usamos trimws() para asegurar que no haya espacios invisibles que rompan el match
df_filtrado <- llamadas %>%
filter(trimws(TIPO_DETALLE) %in% categorias_interes)
# 3. Verificar el resultado
table(df_filtrado$TIPO_DETALLE)
#CREAR CATEGORIAS dummy QUE AGRUPAN LOS DETALLES
# ATRACO : "ATRACO / HURTO EN PROCESO",
#HURTO : "VEHÍCULO HURTADO", "ATRACO / HURTO EN PROCESO"
# VIOLACION DOMICILIO : "INTENTO O VIOLACIÓN DE DOMICILIO", "INTENTO/VIOLACIÓN DE DOMICILIO"
#ALTERACION ORDEN PUBLICO : "ALTERACIÓN DEL ORDEN PÚBLICO", "MANIFESTACIÓN / MOTÍN", "MANIFESTACIÓN O MOTÍN", "DISPAROS", "RIÑA"
#VIOLACION MALTRATO : "VIOLENCIA SEXUAL", "MALTRATO", "MALTRATO A MUJER"
#HOMICIDIO : "MUERTO"
#PANDILLAS Y DROGAS : "NARCÓTICOS", "PANDILLAS", "PANDILLAS JUVENILES"
#ARMAS : "PORTE DE ARMAS", "PORTE ILEGAL DE ARMAS"
#RAPTO Y SECUESTRO: "RAPTO", "RAPTO / SECUESTRO", "SECUESTRO"
# "VENTA O CONSUMO ALCOHOL U OTRO EN MENOR": "VENTA O CONSUMO ALCOHOL U OTRO EN MENOR"
# "PERSONA O VEHÍCULO SOSPECHOSO", "PERSONA PIDIENDO AUXILIO", "PERSONA TENDIDA EN LA VÍA"
# Aseguramos que no haya espacios en blanco en la variable original
df_filtrado <- df_filtrado %>%
mutate(TIPO_DETALLE = trimws(TIPO_DETALLE)) %>%
mutate(
# 1. ATRACO
dummy_atraco = if_else(TIPO_DETALLE == "ATRACO / HURTO EN PROCESO", 1, 0),
# 2. HURTO
dummy_hurto = if_else(TIPO_DETALLE %in% c("VEHÍCULO HURTADO", "ATRACO / HURTO EN PROCESO"), 1, 0),
# 3. VIOLACIÓN DOMICILIO
dummy_violacion_domicilio = if_else(TIPO_DETALLE %in% c("INTENTO O VIOLACIÓN DE DOMICILIO", "INTENTO/VIOLACIÓN DE DOMICILIO"), 1, 0),
# 4. ALTERACIÓN ORDEN PÚBLICO
dummy_alteracion_orden = if_else(TIPO_DETALLE %in% c("ALTERACIÓN DEL ORDEN PÚBLICO", "MANIFESTACIÓN / MOTÍN", "MANIFESTACIÓN O MOTÍN", "DISPAROS", "RIÑA"), 1, 0),
# 5. VIOLACIÓN MALTRATO
dummy_violacion_maltrato = if_else(TIPO_DETALLE %in% c("VIOLENCIA SEXUAL", "MALTRATO", "MALTRATO A MUJER"), 1, 0),
# 6. HOMICIDIO
dummy_homicidio = if_else(TIPO_DETALLE == "MUERTO", 1, 0),
# 7. PANDILLAS Y DROGAS
dummy_pandillas_drogas = if_else(TIPO_DETALLE %in% c("NARCÓTICOS", "PANDILLAS", "PANDILLAS JUVENILES"), 1, 0),
# 8. ARMAS
dummy_armas = if_else(TIPO_DETALLE %in% c("PORTE DE ARMAS", "PORTE ILEGAL DE ARMAS"), 1, 0),
# 9. RAPTO Y SECUESTRO
dummy_rapto_secuestro = if_else(TIPO_DETALLE %in% c("RAPTO", "RAPTO / SECUESTRO", "SECUESTRO"), 1, 0),
# 10. VENTA ALCOHOL MENORES
dummy_alcohol_menores = if_else(TIPO_DETALLE == "VENTA O CONSUMO ALCOHOL U OTRO EN MENOR", 1, 0),
# Categorías de Sospecha y Auxilio (Separadas)
dummy_sospechoso = if_else(TIPO_DETALLE == "PERSONA O VEHÍCULO SOSPECHOSO", 1, 0),
dummy_auxilio    = if_else(TIPO_DETALLE == "PERSONA PIDIENDO AUXILIO", 1, 0),
dummy_tendida    = if_else(TIPO_DETALLE == "PERSONA TENDIDA EN LA VÍA", 1, 0)
)
# Verificar la creación
summary(df_filtrado %>% select(starts_with("dummy_")))
#DESTRING COD UPZ, quitarle las 3 letras iniciales UPZ
# ver valores unicos de COD_UPZ para asegurarnos que el formato es correcto
unique(df_filtrado$COD_UPZ)
#ver cantidad de observaciones
nrow(df_filtrado)
#borrar las observaciones con "-", UPR o que tenga 999
df_filtrado <- df_filtrado %>%
# Eliminamos filas donde COD_UPZ sea "-", contenga "UPR" o el código "999"
filter(COD_UPZ != "-",
!grepl("UPR|999", COD_UPZ))
#ver cantidad de observaciones
nrow(df_filtrado)
# Verificación de los niveles restantes
print(unique(df_filtrado$COD_UPZ))
df_filtrado <- df_filtrado %>%
mutate(
# Extraer solo los dígitos de la cadena
COD_UPZ_NUM = as.numeric(gsub("[^0-9]", "", COD_UPZ))
) %>%
# Opcional: Filtrar registros sin UPZ válida (como el "-" que aparece en tus niveles)
filter(!is.na(COD_UPZ_NUM))
unique(df_filtrado$COD_UPZ_NUM)
unique(df_filtrado$MES)
unique(df_filtrado$ANIO)
#ELIMINAR 2026, 2025, 2024, 2023 (POR AHORA)
df_filtrado <- df_filtrado %>%
filter(ANIO < 2024)
nrow(df_filtrado)
df_filtrado <- df_filtrado %>%
mutate(
# Aseguramos que ANIO y MES sean numéricos antes de operar
ANIO = as.numeric(ANIO),
MES = as.numeric(MES),
# Creamos el número del trimestre
quarter = case_when(
MES %in% 1:3  ~ 1,
MES %in% 4:6  ~ 2,
MES %in% 7:9  ~ 3,
MES %in% 10:12 ~ 4,
TRUE           ~ NA_real_
)
)
#AGRUPAR POR UPZ Y ANIO, Y QUARTER Y SUMAR POR TIPO DE INCIDENTE
df_agrupado <- df_filtrado %>%
group_by(COD_UPZ_NUM, quarter, ANIO) %>%
summarise(
total_atraco = sum(dummy_atraco, na.rm = TRUE),
total_hurto = sum(dummy_hurto, na.rm = TRUE),
total_violacion_domicilio = sum(dummy_violacion_domicilio, na.rm = TRUE),
total_alteracion_orden = sum(dummy_alteracion_orden, na.rm = TRUE),
total_violacion_maltrato = sum(dummy_violacion_maltrato, na.rm = TRUE),
total_homicidio = sum(dummy_homicidio, na.rm = TRUE),
total_pandillas_drogas = sum(dummy_pandillas_drogas, na.rm = TRUE),
total_armas = sum(dummy_armas, na.rm = TRUE),
total_rapto_secuestro = sum(dummy_rapto_secuestro, na.rm = TRUE),
total_alcohol_menores = sum(dummy_alcohol_menores, na.rm = TRUE),
total_sospechoso = sum(dummy_sospechoso, na.rm = TRUE),
total_auxilio = sum(dummy_auxilio, na.rm = TRUE),
total_tendida = sum(dummy_tendida, na.rm = TRUE)
) %>%
ungroup()
#MERGE CON EL PANEL FINAL SEGUN EL QUARTER Y ANIO Y EL UPZ
# VER COLUMNAS DE doc_panel
panel <- read_csv(doc_panel)
# merge entre panel (codigo_upz, year, quarter) y df_agrupado (ANIO, quarter, COD_UPZ_NUM) usando left_join de dplyr
panel_merged <- panel %>%
left_join(df_agrupado, by = c("codigo_upz" = "COD_UPZ_NUM", "year" = "ANIO", "quarter" = "quarter"))
#todos los de total_ (en minuscula), dividirlo sobre TOTAL_POBLACION de su fila para obtener la tasa por cada tipo de incidente y multiplicar por 10,000 para obtener la tasa por cada 10,000 habitantes
panel_merged <- panel_merged %>%
mutate(
across(
.cols = starts_with("total_"),
.fns = ~ (.x / TOTAL_POBLACION) * 10000,
.names = "tasa_{.col}"
)
)
# Verificar las nuevas tasas creadas
glimpse(panel_merged %>% select(starts_with("tasa_")))
#eliminar columna tasa_TOTAL_POBLACION
panel_merged <- panel_merged %>%
select(-tasa_TOTAL_POBLACION)
#imprimir codigo_upz que se repiten en grupo con codigo_upz year y quarter, para ver si hay duplicados
duplicados <- panel_merged %>%
group_by(codigo_upz, year, quarter) %>%
filter(n() > 1)
#quitar las fila duplicadas
panel_merged <- panel_merged %>%
distinct(codigo_upz, year, quarter, .keep_all = TRUE)
#listar observaciones con TOTAL_POBLACION igual a 0, para ver si hay casos donde la tasa no se puede calcular
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
#ELIMINAR CODIGO UPZ 67 Y 117
panel_merged <- panel_merged %>%
filter(!codigo_upz %in% c(63, 117))
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
View(poblacion_cero)
panel_merged <- panel_merged %>%
filter(year < 2023)
poblacion_cero <- panel_merged %>%
filter(TOTAL_POBLACION == 0)
View(poblacion_cero)
